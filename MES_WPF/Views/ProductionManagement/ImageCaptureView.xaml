<UserControl x:Class="MES_WPF.Views.ProductionManagement.ImageCaptureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="1400"
             Focusable="True">

    <Grid Background="#2F4156"
          Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== 第0行：标题栏 ===== -->
        <Grid Grid.Row="0"
              Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Camera:"
                       Foreground="White"
                       FontSize="14"
                       VerticalAlignment="Center" />

            <TextBlock Grid.Column="1"
                       x:Name="PhotoPathText"
                       Text="Photo: -"
                       Foreground="#8FA3BF"
                       FontSize="12"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       TextTrimming="CharacterEllipsis" />
        </Grid>

        <!-- ===== 第1行：主内容区 ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="#2196F3"
                    BorderThickness="1"
                    Background="#0F2438"
                    Margin="0,0,4,0">
                <Grid>
                    <TextBlock x:Name="CameraPlaceholder"
                               Text="Real-time camera"
                               Foreground="#4A6B8A"
                               FontSize="20"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <Image x:Name="CameraImage"
                           Stretch="Uniform" />
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    BorderBrush="#2196F3"
                    BorderThickness="1"
                    Background="#0F2438"
                    Margin="4,0,0,0">
                <Grid>
                    <TextBlock x:Name="PhotoPlaceholder"
                               Text="Captured image"
                               Foreground="#4A6B8A"
                               FontSize="20"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <Image x:Name="PhotoImage"
                           Stretch="Uniform"
                           Visibility="Collapsed" />
                </Grid>
            </Border>
        </Grid>

        <!-- ===== 第2行：按钮区 ===== -->
        <Grid Grid.Row="2"
              Margin="0,8,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧按钮 -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <Button x:Name="Btn_OpenCamera"
                        Content="Open Camera"
                        Width="120"
                        Height="36"
                        Padding="0,5"
                        Background="#2196F3"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="14"
                        Cursor="Hand"
                        Click="Btn_OpenCamera_Click" />

                <Button x:Name="Btn_CloseCamera"
                        Content="Close Camera"
                        Width="120"
                        Height="36"
                        Margin="12,0,0,0"
                        Padding="0,5"
                        Background="#2196F3"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="14"
                        Cursor="Hand"
                        Click="Btn_CloseCamera_Click" />

                <Button x:Name="Btn_SwitchScreen"
                        Content="Switch Screen"
                        Width="120"
                        Height="36"
                        Margin="12,0,0,0"
                        Padding="0,5"
                        Background="#2196F3"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="14"
                        Cursor="Hand"
                        Click="Btn_SwitchScreen_Click" />
            </StackPanel>

            <!-- 右侧按钮 -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <Button x:Name="Btn_SelectFolder"
                        Content="Select Folder"
                        Width="120"
                        Height="36"
                        Padding="0,5"
                        Background="#2196F3"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="14"
                        Cursor="Hand"
                        Click="Btn_SelectFolder_Click" />

                <Button x:Name="Btn_OpenFolder"
                        Content="Open Folder"
                        Width="120"
                        Height="36"
                        Margin="12,0,0,0"
                        Padding="0,5"
                        Background="#2196F3"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="14"
                        Cursor="Hand"
                        Click="Btn_OpenFolder_Click" />

                <Button x:Name="Btn_TakePicture"
                        Content="Take a Picture (Space)"
                        Width="160"
                        Height="36"
                        Margin="12,0,0,0"
                        Padding="0,5"
                        Background="#2196F3"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="14"
                        Cursor="Hand"
                        Click="Btn_TakePicture_Click" />
            </StackPanel>
        </Grid>

        <!-- ===== 第3行：操作日志 ===== -->
        <Border Grid.Row="3"
                BorderBrush="#2196F3"
                BorderThickness="1"
                Background="#0F2438"
                Margin="0,4,0,0"
                Height="180">
            <DataGrid x:Name="dgOperationLog"
                      ItemsSource="{Binding OperationLogs, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      Background="#0F2438"
                      Foreground="White"
                      RowHeight="26"
                      FontSize="8"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background"
                                Value="#132844" />
                        <Setter Property="Foreground"
                                Value="White" />
                        <Setter Property="FontWeight"
                                Value="SemiBold" />
                        <Setter Property="Padding"
                                Value="8" />
                        <Setter Property="Height"
                                Value="28" />
                        <Setter Property="BorderBrush"
                                Value="#2196F3" />
                        <Setter Property="BorderThickness"
                                Value="0,0,1,1" />
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time"
                                        Binding="{Binding Time}"
                                        Width="180" />
                    <DataGridTextColumn Header="Status"
                                        Binding="{Binding Status}"
                                        Width="100" />
                    <DataGridTextColumn Header="Detail"
                                        Binding="{Binding Detail}"
                                        Width="*" />
                </DataGrid.Columns>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background"
                                Value="#0F2438" />
                        <Setter Property="Foreground"
                                Value="White" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}"
                                         Value="OK">
                                <Setter Property="Background"
                                        Value="#0F2F1A" />
                                <Setter Property="Foreground"
                                        Value="#4CAF50" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}"
                                         Value="NG">
                                <Setter Property="Background"
                                        Value="#2F1A1A" />
                                <Setter Property="Foreground"
                                        Value="#F44336" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>