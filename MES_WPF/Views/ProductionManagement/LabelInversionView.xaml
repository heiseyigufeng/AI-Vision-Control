<UserControl x:Class="MES_WPF.Views.ProductionManagement.LabelInversionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="1400">

    <Grid Background="#2F4156"
          Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== 第0行：顶部信息栏 ===== -->
        <Border Grid.Row="0"
                BorderBrush="#2196F3"
                BorderThickness="1"
                Background="#0F2438"
                Margin="0,0,0,4"
                Padding="6,4">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal">
                        <TextBlock Text="WO:"
                                   Foreground="#8FA3BF"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                        <TextBox Text="9910300K6247"
                                 Foreground="White"
                                 Background="#0F2438"
                                 BorderBrush="#2196F3"
                                 BorderThickness="1"
                                 FontSize="12"
                                 Width="120"
                                 Height="24"
                                 Margin="6,0,0,0"
                                 VerticalAlignment="Center"
                                 Padding="4,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Margin="12,0,0,0">
                        <TextBlock Text="Model:"
                                   Foreground="#8FA3BF"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="20-CP101RS07"
                                   Foreground="White"
                                   FontSize="12"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Margin="12,0,0,0">
                        <TextBlock Text="Model:"
                                   Foreground="#8FA3BF"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="20-CP101RS07_Rework"
                                   Foreground="White"
                                   FontSize="12"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                Margin="12,0,0,0">
                        <TextBlock Text="Line:"
                                   Foreground="#8FA3BF"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="A16"
                                   Foreground="White"
                                   FontSize="12"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="4"
                                Orientation="Horizontal"
                                Margin="12,0,0,0">
                        <TextBlock Text="Process:"
                                   Foreground="#8FA3BF"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                        <ComboBox Width="120"
                                  Height="24"
                                  Margin="6,0,0,0"
                                  Background="#0F2438"
                                  Foreground="White"
                                  BorderBrush="#2196F3"
                                  BorderThickness="1"
                                  FontSize="12"
                                  VerticalAlignment="Center"
                                  SelectedIndex="0">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Foreground"
                                            Value="White" />
                                    <Setter Property="Background"
                                            Value="#0F2438" />
                                    <Setter Property="Padding"
                                            Value="6,4" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ComboBoxItem">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        Padding="{TemplateBinding Padding}"
                                                        SnapsToDevicePixels="True">
                                                    <ContentPresenter HorizontalAlignment="Left"
                                                                      VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver"
                                                             Value="True">
                                                        <Setter TargetName="Bd"
                                                                Property="Background"
                                                                Value="#1E4B7A" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected"
                                                             Value="True">
                                                        <Setter TargetName="Bd"
                                                                Property="Background"
                                                                Value="#1565A8" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                            <ComboBoxItem Content="INPUT" />
                            <ComboBoxItem Content="OBD_LabelCheck" />
                            <ComboBoxItem Content="Peel-off" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="5"
                                Orientation="Horizontal"
                                Margin="12,0,0,0">
                        <TextBlock Text="Confidence:"
                                   Foreground="#8FA3BF"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                        <TextBox x:Name="TxtConfidence"
                                 Text="0.66"
                                 Foreground="White"
                                 Background="#0F2438"
                                 BorderBrush="#2196F3"
                                 BorderThickness="1"
                                 FontSize="12"
                                 Width="60"
                                 Height="24"
                                 Margin="6,0,0,0"
                                 VerticalAlignment="Center"
                                 Padding="4,0" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- ===== 第1行：条码 + 输入框 + OK 按钮 ===== -->
        <Grid Grid.Row="1"
              Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="8*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="#2196F3"
                    BorderThickness="1"
                    Background="#0F2438"
                    Height="46">
                <materialDesign:PackIcon Kind="Qrcode"
                                         Width="28"
                                         Height="28"
                                         Foreground="#2196F3"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
            </Border>

            <TextBox Grid.Column="1"
                     x:Name="Txt_Barcode"
                     Text=""
                     Foreground="White"
                     Background="#0F2438"
                     BorderBrush="#2196F3"
                     BorderThickness="1"
                     FontSize="16"
                     Height="46"
                     Margin="6,0"
                     VerticalContentAlignment="Center"
                     Padding="8,0"
                     KeyDown="Txt_Barcode_KeyDown" />

            <Button Grid.Column="2"
                    x:Name="Btn_Detect"
                    Height="46"
                    Background="#0F2F1A"
                    BorderBrush="#4CAF50"
                    BorderThickness="2"
                    Foreground="#4CAF50"
                    FontSize="22"
                    FontWeight="Bold"
                    Cursor="Hand"
                    Content="OK"
                    Click="Btn_Detect_Click" />
        </Grid>

        <!-- ===== 第2行：标题栏 + 相机控制 ===== -->
        <Grid Grid.Row="2"
              Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：相机标题 + Open/Close 按钮 -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock Text="Camera"
                           Foreground="White"
                           FontSize="14"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center" />

                <Button x:Name="Btn_OpenCamera"
                        Content="Open Camera"
                        Width="120"
                        Height="30"
                        Padding="0,5"
                        Background="#2196F3"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="13"
                        Cursor="Hand"
                        Click="Btn_OpenCamera_Click" />

                <Button x:Name="Btn_CloseCamera"
                        Content="Close Camera"
                        Width="120"
                        Height="30"
                        Margin="12,0,0,0"
                        Padding="0,5"
                        Background="#2196F3"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="13"
                        Cursor="Hand"
                        Click="Btn_CloseCamera_Click" />
            </StackPanel>

            <!-- 右侧：Delay Time + 类别 + Manual 按钮 -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        Margin="30,0,0,0"
                        VerticalAlignment="Center">
                <TextBlock Text="Delay Time:"
                           Foreground="White"
                           FontSize="14"
                           VerticalAlignment="Center" />
                <TextBox Text="1.0"
                         Width="100"
                         Height="24"
                         Margin="6,0,0,0"
                         Background="#0F2438"
                         Foreground="White"
                         BorderBrush="#2196F3"
                         BorderThickness="1"
                         FontSize="14"
                         VerticalContentAlignment="Center"
                         Padding="4,0" />

                <ComboBox x:Name="cmb_DetectionClass"
                          Width="180"
                          Height="24"
                          Margin="6,0,6,0"
                          Background="#0F2438"
                          Foreground="White"
                          BorderBrush="#2196F3"
                          BorderThickness="1"
                          FontSize="12"
                          VerticalAlignment="Center"
                          SelectedIndex="0">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Foreground"
                                    Value="White" />
                            <Setter Property="Background"
                                    Value="#0F2438" />
                            <Setter Property="Padding"
                                    Value="6,4" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter HorizontalAlignment="Left"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver"
                                                     Value="True">
                                                <Setter TargetName="Bd"
                                                        Property="Background"
                                                        Value="#1E4B7A" />
                                            </Trigger>
                                            <Trigger Property="IsSelected"
                                                     Value="True">
                                                <Setter TargetName="Bd"
                                                        Property="Background"
                                                        Value="#1565A8" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>
                <ComboBox x:Name="cmb_DetectionClass_NG"
                      Width="180"
                      Height="24"
                      Margin="6,0,6,0"
                      Background="#0F2438"
                      Foreground="White"
                      BorderBrush="#2196F3"
                      BorderThickness="1"
                      FontSize="12"
                      VerticalAlignment="Center"
                      SelectedIndex="0">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Foreground"
                    Value="White" />
                            <Setter Property="Background"
                    Value="#0F2438" />
                            <Setter Property="Padding"
                    Value="6,4" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#1E4B7A" />
                                            </Trigger>
                                            <Trigger Property="IsSelected"
                                     Value="True">
                                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#1565A8" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>
                <Button Content="Manual_OK"
                        Width="100"
                        Height="28"
                        Background="Green"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="13" />
                <Button Content="Manual_NG"
                        Width="100"
                        Height="28"
                        Margin="6,0,0,0"
                        Background="#B71C1C"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="13" />
            </StackPanel>
        </Grid>

        <!-- ===== 第3行：主内容区 ===== -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：实时相机画面 -->
            <Border Grid.Column="0"
                    BorderBrush="#2196F3"
                    BorderThickness="1"
                    Background="#0F2438"
                    Margin="0,0,6,0">
                <Grid>
                    <TextBlock x:Name="CameraPlaceholder"
                               Text="Real-time camera"
                               Foreground="#4A6B8A"
                               FontSize="20"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <Image x:Name="CameraImage"
                           Stretch="Uniform" />
                </Grid>
            </Border>

            <!-- 右侧：拍照图 + 侦测图 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="0,0,0,2">
                    <TextBlock x:Name="OrigPathText"
                               Text="Orig Path: -"
                               Foreground="#8FA3BF"
                               FontSize="11"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               TextTrimming="CharacterEllipsis" />
                </Grid>

                <Grid Grid.Row="1"
                      Margin="0,0,0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            BorderBrush="#2196F3"
                            BorderThickness="1"
                            Background="#0F2438">
                        <Grid>
                            <TextBlock x:Name="PhotoPlaceholder"
                                       Text="Photo"
                                       Foreground="#4A6B8A"
                                       FontSize="18"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <Image x:Name="PhotoImage"
                                   Stretch="Uniform"
                                   Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1"
                                Orientation="Vertical"
                                VerticalAlignment="Center"
                                Margin="4,0,0,0">
                        <Button x:Name="Btn_Load"
                                Content="Load"
                                Width="40"
                                Height="26"
                                Margin="0,3"
                                Padding="5"
                                Background="#1565A8"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="11"
                                Click="Btn_Load_Click" />
                        <Button Content="Open"
                                Width="40"
                                Height="26"
                                Margin="0,3"
                                Padding="5"
                                Background="#1565A8"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="11"
                                Click="Btn_Open_Click" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2"
                      Margin="0,3,0,2">
                    <TextBlock x:Name="ResultPathText"
                               Text="Result Path: -"
                               Foreground="#8FA3BF"
                               FontSize="11"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               TextTrimming="CharacterEllipsis" />
                </Grid>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            BorderBrush="#2196F3"
                            BorderThickness="1"
                            Background="#0F2438">
                        <Grid>
                            <TextBlock x:Name="ResultPlaceholder"
                                       Text="Detection image"
                                       Foreground="#4A6B8A"
                                       FontSize="18"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <Image x:Name="ResultImage"
                                   Stretch="Uniform"
                                   Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <Button Grid.Column="1"
                            Content="Open"
                            Width="40"
                            Height="26"
                            Margin="4,0,0,0"
                            Padding="5"
                            Background="#1565A8"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="11"
                            Click="Btn_OpenResult_Click" />
                </Grid>
            </Grid>
        </Grid>

        <!-- ===== 第4行：操作日志 ===== -->
        <Border Grid.Row="4"
                BorderBrush="#2196F3"
                BorderThickness="1"
                Background="#0F2438"
                Margin="0,4,0,0"
                Height="160">
            <DataGrid x:Name="dgOperationLog"
                      ItemsSource="{Binding OperationLogs, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      Background="#0F2438"
                      Foreground="White"
                      RowHeight="26"
                      FontSize="12"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background"
                                Value="#132844" />
                        <Setter Property="Foreground"
                                Value="White" />
                        <Setter Property="FontWeight"
                                Value="SemiBold" />
                        <Setter Property="Padding"
                                Value="8" />
                        <Setter Property="Height"
                                Value="28" />
                        <Setter Property="BorderBrush"
                                Value="#2196F3" />
                        <Setter Property="BorderThickness"
                                Value="0,0,1,1" />
                    </Style>
                    <!-- 新增：单元格样式，统一修复所有列的裁剪问题 -->
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="4,2" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            BorderThickness="0">
                                        <ContentPresenter VerticalAlignment="Center"
                                          HorizontalAlignment="Left" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time"
                                        Binding="{Binding Time}"
                                        Width="180" />
                    <DataGridTextColumn Header="Status"
                                        Binding="{Binding Status}"
                                        Width="80" />
                    <DataGridTextColumn Header="Detail"
                                        Binding="{Binding Detail}"
                                        Width="*" />
                </DataGrid.Columns>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="#0F2438" />
                        <Setter Property="Foreground" Value="White" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="OK">
                                <Setter Property="Background" Value="#1B5E20" />
                                <Setter Property="Foreground" Value="#A5D6A7" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="NG">
                                <Setter Property="Background" Value="#B71C1C" />
                                <Setter Property="Foreground" Value="#FFCDD2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>